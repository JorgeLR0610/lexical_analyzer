// ==========================================
// Código Fuente Go:
// ==========================================
// package main
// func main() {
//     for i := 0; i < 10; i++ {
//         total += i
//     }
// }

// ==========================================
// Triplos / Cuádruplos (.ir):
// ==========================================
#1  (func_begin, , , main)
#2  (=, 0, , i)
#3  (label, , , L1)
#4  (<, i, 10, t1)
#5  (ifFalse, t1, , L2)
#6  (+, total, i, t2)
#7  (=, t2, , total)
#8  (+, i, 1, t3)
#9  (=, t3, , i)
#10 (goto, , , L1)
#11 (label, , , L2)
#12 (func_end, , , )

// ==========================================
// Código de Tres Direcciones (TAC):
// ==========================================
func main:
i = 0
L1:
t1 = i < 10
ifFalse t1 goto L2
t2 = total + i
total = t2
t3 = i + 1
i = t3
goto L1
L2:
endfunc

// ==========================================
// Notación Postfija (RPN):
// ==========================================
// (i < 10)  ==>  i 10 <