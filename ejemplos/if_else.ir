// ==========================================
// Código Fuente Go:
// ==========================================
// package main
// func main() {
//     if x > 5 {
//         x = x - 1
//     } else {
//         x = 0
//     }
// }

// ==========================================
// Triplos / Cuádruplos (.ir):
// ==========================================
#1  (func_begin, , , main)
#2  (>, x, 5, t1)
#3  (ifFalse, t1, , L1)
#4  (-, x, 1, t2)
#5  (=, t2, , x)
#6  (goto, , , L2)
#7  (label, , , L1)
#8  (=, 0, , x)
#9  (label, , , L2)
#10 (func_end, , , )

// ==========================================
// Código de Tres Direcciones (TAC):
// ==========================================
func main:
t1 = x > 5
ifFalse t1 goto L1
t2 = x - 1
x = t2
goto L2
L1:
x = 0
L2:
endfunc

// ==========================================
// Notación Postfija (RPN):
// ==========================================
// (x > 5)  ==>  x 5 >
// (x - 1)  ==>  x 1 -