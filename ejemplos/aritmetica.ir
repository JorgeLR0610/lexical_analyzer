// ==========================================
// Código Fuente Go:
// ==========================================
// package main
// func main() {
//     x := 3 + 4 * 2
// }

// ==========================================
// Triplos / Cuádruplos (.ir):
// ==========================================
#1  (func_begin, , , main)
#2  (*, 4, 2, t1)
#3  (+, 3, t1, t2)
#4  (=, t2, , x)
#5  (func_end, , , )

// ==========================================
// Código de Tres Direcciones (TAC):
// ==========================================
func main:
t1 = 4 * 2
t2 = 3 + t1
x = t2
endfunc

// ==========================================
// Notación Postfija (RPN):
// ==========================================
// (3 + (4 * 2))  ==>  3 4 2 * +